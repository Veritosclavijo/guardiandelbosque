[node name="Zona3Incendio" type="Node2D" unique_id=1398492981]
script = ExtResource("1_ifi26")
nombre_zona = "ZONA 3: INCENDIO"
viento = Vector2i(1, 0)
objetivo = "¡Un gran incendio rodea el campamento y el viento cambia de dirección!
- Habla con los campistas (E) y guíalos al PUNTO DE ENCUENTRO.
- Apaga el fuego y las chispas; recarga la cubeta en el lago.
- Al final, reforesta lo quemado."
aprendiste = "En un incendio primero se protegen las vidas: hay que salir en dirección contraria al fuego y al viento, hacia un punto de encuentro seguro. El viento puede cambiar en cualquier momento."
musica = "musica_incendio"
cambio_viento_segundos = 25.0

