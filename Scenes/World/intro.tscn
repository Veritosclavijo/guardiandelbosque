imagenes = Array[Texture2D]([ExtResource("2_qe8ir"), ExtResource("3_7qnaf"), ExtResource("4_vrhp8"), ExtResource("5_58oy5")])
textos = PackedStringArray("El bosque es el hogar de miles de especies. Además, nos da agua limpia, aire puro y sombra.", "Este año la sequía dejó el pasto seco. Una fogata mal apagada, una colilla o un vidrio al sol bastan para iniciar un incendio.", "Cuando el fuego empieza, el viento lo empuja y las chispas lo esparcen. En pocos minutos puede destruir lo que tardó años en crecer.", "Tú eres el guardabosques. Previene los riesgos, combate el fuego con la cubeta y la pala, y reforesta. ¡El bosque cuenta contigo!")
siguiente_escena = "res://Scenes/World/zona_1_camping.tscn"

