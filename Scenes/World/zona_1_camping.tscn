script = ExtResource("7_k4phc")
textura = ExtResource("8_0l43f")
pregunta = "¡Hola! Ya me voy del camping. ¿Puedo dejar la fogata prendida? Total, se apaga sola."
opciones = PackedStringArray("Sí, se apaga sola", "No: hay que apagarla con agua o tierra hasta que no quede calor", "Solo si no hace viento")
correcta = 1
explicacion_correcta = "¡Tienes razón! Las brasas siguen calientes por horas y el viento puede reavivarlas. ¡Gracias, guardián! (+1 corazón)"
explicacion_incorrecta = "Mmm, no. Las brasas siguen calientes por horas y el viento puede reavivarlas. Hay que apagarla por completo con agua o tierra."
frase_final = "Ya aprendí: nunca dejar una fogata encendida."

[node name="Campesino" type="StaticBody2D" parent="Mundo/NPCs" unique_id=971268662 instance=ExtResource("6_k23vi")]
